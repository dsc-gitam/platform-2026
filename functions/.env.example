# Non-secret settings for the function (copy to .env.gdg-gitam; it is git-ignored because it holds personal emails).
# Secrets (DATABASE_URL, GOOGLE_SERVICE_ACCOUNT, GITHUB_TOKEN) live in Secret Manager: see docs/03-setup.md.
SUPERADMIN_EMAILS=you@example.com
ALLOWED_ORIGINS=https://gdg-gitam.web.app,https://gdg-gitam.firebaseapp.com,http://localhost:4173
GITHUB_REPO=dsc-gitam/platform-2026
GITHUB_BRANCH=main
