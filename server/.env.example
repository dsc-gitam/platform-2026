# --- Database (Supabase Postgres) ---
# Runtime connection: Supabase "Transaction pooler" string (port 6543, add ?pgbouncer=true if you use Prisma migrate elsewhere)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection, used by `deno task migrate` (port 5432)
DIRECT_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# --- Firebase Auth ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service-account JSON (one line). Needed to set role custom claims and send push notifications (FCM).
GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- Access control ---
# Comma-separated emails that become ADMIN the first time they sign in
SUPERADMIN_EMAILS=you@example.com
# Origins allowed to call the API (your site)
ALLOWED_ORIGINS=https://gdg-gitam.example.com,http://localhost:4173

# --- GitHub publishing (stories, team, events -> commit -> deploy) ---
GITHUB_TOKEN=github_pat_xxx   # fine-grained token: Contents read/write on the site repo
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

PORT=8000
# NEVER set in production. Lets you sign in locally with an `x-dev-user` header instead of Firebase.
# DEV_AUTH=1
