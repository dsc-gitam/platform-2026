{
  "nodeModulesDir": "auto",
  "imports": {
    "hono": "npm:hono@4.6.14",
    "hono/cors": "npm:hono@4.6.14/cors",
    "jose": "npm:jose@5.9.6",
    "@prisma/client": "npm:@prisma/client@7.0.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@7.0.0"
  },
  "tasks": {
    "dev": "deno run -A --watch --env-file=.env src/main.ts",
    "start": "deno run -A src/main.ts",
    "generate": "deno run -A npm:prisma@7.0.0 generate",
    "migrate": "deno run -A --env-file=.env npm:prisma@7.0.0 migrate deploy",
    "migrate:dev": "deno run -A --env-file=.env npm:prisma@7.0.0 migrate dev",
    "seed": "deno run -A --env-file=.env src/seed.ts",
    "check": "deno check src/main.ts src/seed.ts",
    "test": "deno test -A --env-file=.env.test src/"
  },
  "compilerOptions": { "strict": true },
  "lint": { "rules": { "exclude": ["no-explicit-any"] } },
  "exclude": ["generated", "node_modules"]
}
